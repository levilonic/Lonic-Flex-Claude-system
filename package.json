  "description": "12-Factor Agents methodology with live multi-agent infrastructure implementation",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "cli": "node cli.js",
    "test": "node cli.js test",
    "status": "node cli.js status",
