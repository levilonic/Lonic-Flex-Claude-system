    "integration:test": "node tests/integration/test-phase3a-integration.js",
    "agents:base": "node src/agents/base-agent.js",
    "agents:github": "node src/agents/github-agent.js",
    "agents:security": "node src/agents/security-agent.js",
    "agents:code": "node src/agents/code-agent.js",
    "verify:all": "node src/memory/status-verifier.js --all",
    "verify:discrepancies": "node src/memory/status-verifier.js --discrepancies"
  },
  "keywords": [
    "ai-agents",
