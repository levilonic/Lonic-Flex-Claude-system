{
  "name": "lonicflex-12-factor-agents",
  "version": "1.0.0",
  "description": "12-Factor Agents methodology with live multi-agent infrastructure implementation",
  "main": "index.js",
  "scripts": {
    "demo": "node demo.js",
    "working-demo": "node working-demo.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "cli": "node cli.js",
    "cli-working": "node cli-working.js",
    "core": "node core-cli.js",
    "core:api": "node core-api.js",
    "test": "node tests/test-runner.js --category=all",
    "test:smoke": "node tests/test-runner.js --category=smoke",
    "test:unit": "node tests/test-runner.js --category=unit",
    "test:integration": "node tests/test-runner.js --category=integration",
    "test:e2e": "node tests/test-runner.js --category=e2e",
    "test:core": "node test-core-system.js",
    "test:legacy": "node cli.js test",
    "test:real": "node tests/real/pr-review-integration.test.js",
    "test:coverage": "node analyze-test-coverage.js",
    "test:enforce": "node enforce-test-coverage.js",
    "verify-agents": "node verify-all-agents.js",
    "verify-all": "npm run test && npm run verify-agents && npm run test:coverage",
    "context:health": "node src/context-management/context-window-monitor.js",
    "context:test": "node tests/integration/test-universal-context.js",
    "status": "node cli.js status",
    "health": "node cli.js health",
    "agents": "node cli.js agents",
    "agents:base": "node src/agents/base-agent.js",
    "agents:github": "node src/agents/github-agent.js",
    "agents:security": "node src/agents/security-agent.js",
    "agents:code": "node src/agents/code-agent.js",
    "services:start": "pm2 start config/ecosystem.config.js",
    "services:stop": "pm2 stop all",
    "services:restart": "pm2 restart all",
    "services:status": "pm2 status",
    "services:logs": "pm2 logs",
    "services:monitor": "pm2 monit",
    "services:delete": "pm2 delete all",
    "verify:all": "node src/memory/status-verifier.js --all",
    "verify:discrepancies": "node src/memory/status-verifier.js --discrepancies",
    "verify:docs": "node verify-docs.js",
    "verify": "npm run test && npm run test:coverage && npm run test:enforce",
    "smoke": "node src/smoke.js",
    "smoke:services": "node scripts/check-services-health.js",
    "smoke:full": "node test-smoke-comprehensive.js",
    "prepare": "husky"
  },
  "keywords": [
    "ai-agents",
    "12-factor",
    "multi-agent",
    "claude",
    "slack",
    "github",
    "docker",
    "coordination"
  ],
  "author": "Levi",
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/graphql": "^9.0.1",
    "@octokit/rest": "^20.0.2",
    "@slack/bolt": "^3.17.1",
    "ansi-colors": "^4.1.3",
    "archiver": "^6.0.1",
    "axios": "^1.6.5",
    "body-parser": "^1.20.2",
    "cli-progress": "^3.12.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "pm2": "^6.0.11",
    "redis": "^4.6.12",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanlayer/12-factor-agents.git"
  },
  "bugs": {
    "url": "https://github.com/humanlayer/12-factor-agents/issues"
  },
  "homepage": "https://github.com/humanlayer/12-factor-agents#readme",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
