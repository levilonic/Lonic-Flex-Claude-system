{
  "environment": "production",
  "version": "1.0.0",
  
  "claude_multi_agent": {
    "max_concurrent_sessions": 15,
    "session_timeout": 300000,
    "context_window_threshold": 0.8,
    "factor_3_xml_enabled": true
  },

  "agents": {
    "github": {
      "enabled": true,
      "max_instances": 5,
      "timeout": 120000,
      "config": {
        "rate_limit": 5000,
        "cache_ttl": 3600
      },
      "docker": {
        "memory": "512MB",
        "cpu_shares": 1024
      }
    },
    "security": {
      "enabled": true,
      "max_instances": 3,
      "timeout": 180000,
      "config": {
        "severity_threshold": "medium",
        "scan_depth": "full",
        "enable_cve_lookup": true
      },
      "docker": {
        "memory": "1GB",
        "cpu_shares": 2048
      }
    },
    "code": {
      "enabled": true,
      "max_instances": 6,
      "timeout": 240000,
      "config": {
        "quality_threshold": 85,
        "test_coverage_minimum": 80
      },
      "docker": {
        "memory": "1GB",
        "cpu_shares": 2048
      }
    },
    "deploy": {
      "enabled": true,
      "max_instances": 3,
      "timeout": 600000,
      "config": {
        "default_strategy": "blue-green",
        "health_check_timeout": 60000,
        "rollback_on_failure": true
      },
      "docker": {
        "memory": "512MB",
        "cpu_shares": 1024
      }
    },
    "communication": {
      "enabled": true,
      "max_instances": 2,
      "timeout": 30000,
      "config": {
        "notification_channels": ["#deployments", "#alerts", "#production"]
      },
      "docker": {
        "memory": "256MB",
        "cpu_shares": 512
      }
    }
  },

  "workflows": {
    "feature_development": {
      "enabled": true,
      "agents": ["github", "security", "code", "deploy"],
      "timeout": 900000,
      "approval_required": true
    },
    "bug_fix": {
      "enabled": true,
      "agents": ["github", "security", "deploy"],
      "timeout": 600000,
      "approval_required": true
    },
    "security_scan": {
      "enabled": true,
      "agents": ["security", "github"],
      "timeout": 180000,
      "approval_required": false
    },
    "deployment": {
      "enabled": true,
      "agents": ["security", "deploy", "communication"],
      "timeout": 600000,
      "approval_required": true
    },
    "code_review": {
      "enabled": true,
      "agents": ["security", "github", "communication"],
      "timeout": 300000,
      "approval_required": false
    }
  },

  "integrations": {
    "slack": {
      "enabled": true,
      "webhook_port": 3000,
      "socket_mode": true,
      "oauth_scopes": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "reactions:read",
        "workflow.steps:execute",
        "users:read"
      ]
    },
    "github": {
      "enabled": true,
      "webhook_port": 3001,
      "supported_events": [
        "pull_request",
        "push", 
        "release",
        "issues",
        "security_advisory"
      ]
    },
    "docker": {
      "enabled": true,
      "network_name": "claude-agents-prod",
      "deployment_strategies": ["blue-green", "rolling", "canary"]
    }
  },

  "database": {
    "file": "claude-agents-prod.db",
    "wal_mode": true,
    "backup_interval": 1800,
    "cleanup_days": 30
  },

  "logging": {
    "level": "warn",
    "format": "json",
    "outputs": [
      {
        "type": "console",
        "level": "error"
      },
      {
        "type": "file",
        "filename": "claude-agents-prod.log",
        "max_size": "200MB",
        "max_files": 10
      },
      {
        "type": "file",
        "filename": "claude-agents-audit.log",
        "level": "info",
        "max_size": "500MB",
        "max_files": 20
      }
    ]
  },

  "monitoring": {
    "health_check_interval": 15000,
    "metrics_enabled": true,
    "prometheus_port": 9090,
    "alerts": {
      "agent_failure_threshold": 2,
      "workflow_timeout_alert": true,
      "resource_usage_threshold": 0.8
    }
  },

  "security": {
    "webhook_signature_verification": true,
    "api_rate_limiting": true,
    "max_requests_per_minute": 100,
    "cors_enabled": false,
    "https_only": true
  }
}