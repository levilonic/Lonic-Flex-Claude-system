{
  "environment": "staging",
  "version": "1.0.0-staging",
  
  "claude_multi_agent": {
    "max_concurrent_sessions": 8,
    "session_timeout": 300000,
    "context_window_threshold": 0.75,
    "factor_3_xml_enabled": true
  },

  "agents": {
    "github": {
      "enabled": true,
      "timeout": 90000,
      "config": {
        "rate_limit": 3000,
        "cache_ttl": 1800
      },
      "docker": {
        "memory": "256MB",
        "cpu_shares": 512
      }
    },
    "security": {
      "enabled": true,
      "timeout": 150000,
      "config": {
        "severity_threshold": "medium",
        "scan_depth": "full"
      },
      "docker": {
        "memory": "512MB",
        "cpu_shares": 1024
      }
    },
    "code": {
      "enabled": true,
      "timeout": 180000,
      "config": {
        "quality_threshold": 75,
        "test_coverage_minimum": 70
      },
      "docker": {
        "memory": "768MB",
        "cpu_shares": 1536
      }
    },
    "deploy": {
      "enabled": true,
      "timeout": 450000,
      "config": {
        "default_strategy": "rolling",
        "health_check_timeout": 45000,
        "rollback_on_failure": true
      },
      "docker": {
        "memory": "256MB",
        "cpu_shares": 512
      }
    },
    "communication": {
      "enabled": true,
      "timeout": 20000,
      "config": {
        "notification_channels": ["#staging-deployments", "#dev-team"]
      }
    }
  },

  "workflows": {
    "feature_development": {
      "enabled": true,
      "agents": ["github", "security", "code", "deploy"],
      "timeout": 600000,
      "approval_required": false
    },
    "bug_fix": {
      "enabled": true,
      "agents": ["github", "security", "deploy"],
      "timeout": 400000,
      "approval_required": false
    },
    "security_scan": {
      "enabled": true,
      "agents": ["security", "github"],
      "timeout": 150000,
      "approval_required": false
    },
    "deployment": {
      "enabled": true,
      "agents": ["security", "deploy", "communication"],
      "timeout": 450000,
      "approval_required": true
    },
    "code_review": {
      "enabled": true,
      "agents": ["security", "github", "communication"],
      "timeout": 200000,
      "approval_required": false
    }
  },

  "integrations": {
    "slack": {
      "enabled": true,
      "webhook_port": 3000,
      "socket_mode": true
    },
    "github": {
      "enabled": true,
      "webhook_port": 3001,
      "supported_events": [
        "pull_request",
        "push",
        "release",
        "issues"
      ]
    },
    "docker": {
      "enabled": true,
      "network_name": "claude-agents-staging",
      "deployment_strategies": ["rolling", "blue-green"]
    }
  },

  "database": {
    "file": "claude-agents-staging.db",
    "backup_interval": 3600,
    "cleanup_days": 7
  },

  "logging": {
    "level": "info",
    "outputs": [
      {
        "type": "console"
      },
      {
        "type": "file",
        "filename": "claude-agents-staging.log",
        "max_size": "100MB",
        "max_files": 3
      }
    ]
  },

  "monitoring": {
    "health_check_interval": 30000,
    "metrics_enabled": true,
    "prometheus_port": 9091,
    "alerts": {
      "agent_failure_threshold": 3,
      "workflow_timeout_alert": true,
      "resource_usage_threshold": 0.85
    }
  },

  "security": {
    "webhook_signature_verification": true,
    "api_rate_limiting": true,
    "max_requests_per_minute": 200,
    "cors_enabled": false,
    "https_only": false
  }
}