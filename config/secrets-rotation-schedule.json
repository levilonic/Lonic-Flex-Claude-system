{
  "version": "1.0.0",
  "description": "Automated secrets rotation schedule configuration",
  "environment": "development",
  
  "rotation_schedule": {
    "enabled": true,
    "timezone": "UTC",
    "check_interval_hours": 24,
    "rotation_time": "02:00",
    "max_concurrent_rotations": 2,
    "retry_attempts": 3,
    "retry_delay_minutes": 5
  },

  "services": {
    "github": {
      "enabled": true,
      "rotation_interval_days": 30,
      "notification_days_before": [7, 3, 1],
      "backup_retention_days": 90,
      "test_endpoint": "https://api.github.com/user",
      "rotation_method": "github_app",
      "emergency_contact": "admin@company.com"
    },
    "slack": {
      "enabled": true,
      "rotation_interval_days": 90,
      "notification_days_before": [14, 7, 3],
      "backup_retention_days": 180,
      "test_endpoint": "https://slack.com/api/auth.test",
      "rotation_method": "oauth_refresh",
      "emergency_contact": "admin@company.com"
    },
    "docker": {
      "enabled": false,
      "rotation_interval_days": 60,
      "notification_days_before": [10, 5, 2],
      "backup_retention_days": 120,
      "test_endpoint": "https://index.docker.io/v1/",
      "rotation_method": "registry_api",
      "emergency_contact": "admin@company.com"
    },
    "anthropic": {
      "enabled": false,
      "rotation_interval_days": 90,
      "notification_days_before": [14, 7, 3],
      "backup_retention_days": 180,
      "test_endpoint": "https://api.anthropic.com/v1/messages",
      "rotation_method": "manual",
      "emergency_contact": "admin@company.com"
    }
  },

  "notification_channels": {
    "slack": {
      "enabled": true,
      "channel": "#security-alerts",
      "webhook_url": "${SLACK_SECURITY_WEBHOOK}",
      "mention_users": ["@security-team", "@admin"],
      "notification_types": [
        "rotation_scheduled",
        "rotation_success",
        "rotation_failed",
        "rotation_reminder"
      ]
    },
    "email": {
      "enabled": false,
      "smtp_server": "${SMTP_SERVER}",
      "smtp_port": 587,
      "from_address": "security@company.com",
      "to_addresses": ["admin@company.com", "security@company.com"],
      "notification_types": [
        "rotation_failed",
        "rotation_reminder"
      ]
    },
    "webhook": {
      "enabled": false,
      "url": "${SECURITY_WEBHOOK_URL}",
      "headers": {
        "Authorization": "Bearer ${WEBHOOK_TOKEN}",
        "Content-Type": "application/json"
      },
      "notification_types": [
        "rotation_success",
        "rotation_failed"
      ]
    }
  },

  "backup_configuration": {
    "enabled": true,
    "storage_location": "./auth/secrets-backups",
    "encryption_enabled": true,
    "compression_enabled": true,
    "max_backups_per_service": 5,
    "cleanup_interval_days": 30,
    "verification_checks": true
  },

  "security_policies": {
    "require_manual_approval": {
      "production": true,
      "staging": false,
      "development": false
    },
    "approval_timeout_minutes": 60,
    "emergency_bypass": {
      "enabled": true,
      "required_approvers": 2,
      "audit_logging": true
    },
    "rotation_window": {
      "start_hour": 2,
      "end_hour": 6,
      "timezone": "UTC",
      "exclude_weekends": false
    }
  },

  "monitoring": {
    "health_checks": {
      "enabled": true,
      "interval_minutes": 60,
      "timeout_seconds": 30,
      "retry_attempts": 3
    },
    "metrics": {
      "enabled": true,
      "track_rotation_duration": true,
      "track_success_rate": true,
      "track_failure_reasons": true
    },
    "alerts": {
      "rotation_overdue": {
        "enabled": true,
        "threshold_days": 5,
        "severity": "high"
      },
      "rotation_failed": {
        "enabled": true,
        "severity": "critical",
        "escalation_minutes": 30
      },
      "token_validation_failed": {
        "enabled": true,
        "threshold_failures": 3,
        "severity": "high"
      }
    }
  },

  "compliance": {
    "audit_logging": {
      "enabled": true,
      "log_file": "./logs/secrets-rotation-audit.log",
      "include_token_metadata": true,
      "retention_days": 365
    },
    "regulatory_requirements": {
      "pci_dss": false,
      "sox": false,
      "gdpr": true,
      "hipaa": false
    },
    "documentation": {
      "generate_reports": true,
      "report_interval_days": 30,
      "include_metrics": true,
      "export_formats": ["json", "pdf"]
    }
  },

  "environment_overrides": {
    "development": {
      "rotation_schedule": {
        "enabled": false
      },
      "services": {
        "github": {
          "rotation_interval_days": 365
        },
        "slack": {
          "rotation_interval_days": 365
        }
      },
      "security_policies": {
        "require_manual_approval": {
          "development": false
        }
      }
    },
    "staging": {
      "rotation_schedule": {
        "check_interval_hours": 12
      },
      "services": {
        "github": {
          "rotation_interval_days": 60
        },
        "slack": {
          "rotation_interval_days": 120
        }
      }
    },
    "production": {
      "rotation_schedule": {
        "check_interval_hours": 6
      },
      "services": {
        "github": {
          "rotation_interval_days": 14,
          "notification_days_before": [7, 3, 1, 0]
        },
        "slack": {
          "rotation_interval_days": 30,
          "notification_days_before": [10, 5, 2, 1, 0]
        }
      },
      "security_policies": {
        "require_manual_approval": {
          "production": true
        },
        "emergency_bypass": {
          "required_approvers": 3
        }
      },
      "monitoring": {
        "health_checks": {
          "interval_minutes": 15
        }
      }
    }
  },

  "testing": {
    "dry_run_mode": {
      "enabled": true,
      "log_actions": true,
      "simulate_api_calls": true
    },
    "test_scenarios": [
      "successful_rotation",
      "api_failure",
      "network_timeout",
      "invalid_token",
      "backup_failure"
    ],
    "validation_checks": [
      "token_format",
      "api_connectivity", 
      "permission_verification",
      "expiration_check"
    ]
  }
}