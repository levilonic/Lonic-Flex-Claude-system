# =====================================================
# LonicFLex System Environment Configuration
# =====================================================
# Complete configuration for all 13 production services
# Copy this to .env and fill in your actual values
#
# IMPORTANT: ALL services must be configured for production use.
# No "optional" services - this is systematic implementation.
# =====================================================

# =====================================================
# CORE SYSTEM CONFIGURATION
# =====================================================

# Environment
NODE_ENV=development                # development | production | test

# Database
DB_PATH=./database/agents.db        # SQLite database path

# Logging
LOG_LEVEL=info                      # debug | info | warn | error

# =====================================================
# CORE INFRASTRUCTURE SERVICES (Required)
# =====================================================

# Master Service (Port 3007)
MASTER_SERVICE_PORT=3007

# Webhook Service (Port 3008)
WEBHOOK_SERVICE_PORT=3008

# Workflows Service (Port 3004)
WORKFLOWS_SERVICE_PORT=3004

# Health Service (Port 3005)
HEALTH_SERVICE_PORT=3005

# Integration Hub Service (Port 3020)
INTEGRATION_HUB_PORT=3020

# Permissions Service (Port 3031)
PERMISSIONS_PORT=3031

# =====================================================
# GITHUB INTEGRATION SERVICE (Port 3002) - Required
# =====================================================

GITHUB_TOKEN=                       # GitHub Personal Access Token (ghp_...)
                                    # Scopes needed: repo, workflow, admin:repo_hook

GITHUB_OWNER=levilonic              # GitHub repository owner/organization
GITHUB_REPO=LonicFLex               # GitHub repository name
GITHUB_SERVICE_PORT=3002            # Service port

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET=              # Secret for webhook validation
WEBHOOK_URL=                        # External webhook URL (e.g., https://your-domain.com/webhook)

# =====================================================
# SLACK INTEGRATION SERVICE (Port 3006) - Required
# =====================================================

SLACK_BOT_TOKEN=                    # Slack Bot User OAuth Token (xoxb-...)
                                    # Scopes needed: chat:write, channels:read, users:read

SLACK_APP_TOKEN=                    # Slack App-Level Token (xapp-...)
                                    # Required for Socket Mode

SLACK_SIGNING_SECRET=               # Slack App Signing Secret
                                    # Found in Slack App settings

SLACK_SERVICE_PORT=3006             # Service port
ENABLE_SLACK_INTEGRATION=true       # Enable/disable Slack integration

# =====================================================
# GITLAB INTEGRATION SERVICE (Port 3025) - Required
# =====================================================

GITLAB_URL=https://gitlab.com       # GitLab instance URL
GITLAB_ACCESS_TOKEN=                # GitLab Personal Access Token (glpat-...)
                                    # Scopes needed: api, read_repository, write_repository

GITLAB_WEBHOOK_SECRET=              # Secret for webhook validation
GITLAB_DEFAULT_PROJECT=             # Default project ID (numeric)
GITLAB_SERVICE_PORT=3025            # Service port

# =====================================================
# JIRA INTEGRATION SERVICE (Port 3021) - Required
# =====================================================

JIRA_URL=https://your-domain.atlassian.net  # Jira Cloud instance URL
JIRA_EMAIL=                         # Jira account email
JIRA_API_TOKEN=                     # Jira API Token (generated from Atlassian account)
JIRA_WEBHOOK_SECRET=                # Secret for webhook validation
JIRA_DEFAULT_PROJECT=LONIC          # Default project key
JIRA_SERVICE_PORT=3021              # Service port
JIRA_DEMO_MODE=false                # Enable demo mode (mock responses)

# =====================================================
# SERVICENOW INTEGRATION (Port 3022) - Required
# =====================================================

SERVICENOW_INSTANCE_URL=https://dev123456.service-now.com  # ServiceNow instance URL
SERVICENOW_USERNAME=                # ServiceNow username
SERVICENOW_PASSWORD=                # ServiceNow password

# OAuth Credentials (alternative to username/password)
SERVICENOW_CLIENT_ID=               # OAuth Client ID
SERVICENOW_CLIENT_SECRET=           # OAuth Client Secret

SERVICENOW_SERVICE_PORT=3022        # Service port
SERVICENOW_DEMO_MODE=false          # Enable demo mode (mock responses)

# =====================================================
# LINEAR INTEGRATION SERVICE (Port 3023) - Required
# =====================================================

LINEAR_API_TOKEN=                   # Linear API Key (lin_api_...)
                                    # Generated from Linear Settings > API

LINEAR_WEBHOOK_SECRET=              # Secret for webhook validation
LINEAR_DEFAULT_TEAM=                # Default team ID (UUID)
LINEAR_SERVICE_PORT=3023            # Service port

# =====================================================
# JENKINS INTEGRATION SERVICE (Port 3024) - Required
# =====================================================

JENKINS_URL=http://localhost:8080   # Jenkins server URL
JENKINS_USERNAME=                   # Jenkins username
JENKINS_API_TOKEN=                  # Jenkins API Token (generated from user settings)
JENKINS_SERVICE_PORT=3024           # Service port

# =====================================================
# EXTERNAL SERVICES (Optional but Recommended)
# =====================================================

# MCP Service API Keys
BING_API_KEY=                       # Bing Search API key
FIRECRAWL_API_KEY=                  # Firecrawl API key
BRAVE_API_KEY=                      # Brave Search API key

# Docker Hub
DOCKER_HUB_TOKEN=                   # Docker Hub access token

# Bright Data Proxy
BRIGHT_DATA_ZONE=                   # Bright Data zone
BRIGHT_DATA_USERNAME=               # Bright Data username
BRIGHT_DATA_PASSWORD=               # Bright Data password

# =====================================================
# SERVICE DEPENDENCY MAP
# =====================================================
# master → github, webhook
# webhook → github, slack
# workflows → master, webhook, integration-hub
# health → all services (monitoring)
# integration-hub → github, slack, gitlab, jira, servicenow, linear, jenkins
# permissions → all services (RBAC)
#
# External Integrations:
# - github: Core GitHub automation
# - slack: Team notifications and commands
# - gitlab: GitLab repository management
# - jira: Issue tracking and project management
# - servicenow: ITSM and incident management
# - linear: Modern issue tracking
# - jenkins: CI/CD pipeline automation
# =====================================================

# =====================================================
# CREDENTIAL ACQUISITION CHECKLIST
# =====================================================
#
# ✅ GitHub:
#    1. Go to https://github.com/settings/tokens
#    2. Generate new token (classic)
#    3. Scopes: repo, workflow, admin:repo_hook
#
# ✅ Slack:
#    1. Go to https://api.slack.com/apps
#    2. Create new app or select existing
#    3. Enable Socket Mode → generate SLACK_APP_TOKEN
#    4. OAuth & Permissions → install to workspace → copy SLACK_BOT_TOKEN
#    5. Basic Information → copy SLACK_SIGNING_SECRET
#
# ✅ GitLab:
#    1. Go to https://gitlab.com/-/profile/personal_access_tokens
#    2. Create token with: api, read_repository, write_repository
#
# ✅ Jira:
#    1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#    2. Create API token
#    3. Use your Atlassian account email
#
# ✅ ServiceNow:
#    1. Instance URL: your ServiceNow developer instance
#    2. Username/Password: your ServiceNow credentials
#    3. OR set up OAuth in ServiceNow admin
#
# ✅ Linear:
#    1. Go to https://linear.app/settings/api
#    2. Create Personal API Key
#
# ✅ Jenkins:
#    1. Jenkins → User → Configure
#    2. Generate API Token
#
# =====================================================
