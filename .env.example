# LonicFLex Environment Configuration Template
# Copy to .env and set your production values

# Security - Required for production
SECRETS_PASSPHRASE=your-secure-passphrase-here

# GitHub Integration (Optional)
GITHUB_TOKEN=your-github-personal-access-token

# Slack Integration (Optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Database Configuration (Optional)
DATABASE_PATH=./multi-agent-coordination.db

# System Configuration (Optional)
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# Docker Configuration (Optional)
DOCKER_NETWORK=claude-agents
DOCKER_VOLUME_PREFIX=claude-agent

# Redis Configuration (Optional - for scaling)
REDIS_URL=redis://localhost:6379

# Monitoring (Optional)
MONITORING_ENABLED=true
METRICS_INTERVAL=60000

# Security Settings
ENABLE_SECURITY_SCANNER=true
SECURITY_THRESHOLD=medium
AUDIT_LOGGING=true