# LonicFlex Environment Variables
# Copy this to .env and fill in your actual values

# External service health endpoints (used by smoke checks and CI)
LFX_GITHUB_HEALTH_URL=https://your.github.service/health
LFX_GITLAB_HEALTH_URL=https://your.gitlab.service/health
LFX_JENKINS_HEALTH_URL=https://your.jenkins.service/health
LFX_SLACK_HEALTH_URL=https://your.slack.service/health
LFX_OPTIONAL_SERVICES=
LFX_ADDITIONAL_SERVICES=

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret-here

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# External Webhook URL (for GitHub webhook configuration)
EXTERNAL_WEBHOOK_URL=https://your-ngrok-or-domain.com

# Database Configuration
DB_PATH=./database/agents.db
LOG_LEVEL=info

# Production Settings
NODE_ENV=development

# Optional: MCP Service API Keys (if using external services)
BING_API_KEY=your_bing_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# Docker Hub (optional)
DOCKER_HUB_TOKEN=your_docker_hub_token_here

# Bright Data (optional)
BRIGHT_DATA_ZONE=your_zone
BRIGHT_DATA_USERNAME=your_username
BRIGHT_DATA_PASSWORD=your_password
